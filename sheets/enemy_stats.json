  "kind": "person (carries gun/shield/relic like the guns' people) | creature (drops a random item at death) | dragon (a boss) | critter (nothing)",
  "bl2_family": "the closest Borderlands 2 enemy family (GD_Population_<family>) whose numbers can stand in; '-' none",
  "health_mult": "general health multiplier for the class before any Badass tier (1.0 = Skyrim's own)",
  "damage_mult": "general damage multiplier for the class before any Badass tier",
  "badass": "yes = may roll a Badass tier; no = never",
  "boss": "always = always a boss (at least Super Badass, always drops); level = a boss when unique or level >= ShieldBossLevel (35); no = never",
  "drop_scale": "the share of a person's drop chance this class gets at death (people 1.0, creatures 0.5 = the user's 'half', critters 0); bosses always drop",
  "min_rarity": "lowest rarity a drop of this class can be (1 common ... 6 e-tech)",
  "source": "bl2 or design",
  "bl2_object": "the Borderlands 2 object the numbers come from ('-' when none yet)",
  "note": "why",
  "in_game": "yes once seen in game"
 },
